# NovaCare - Bảo vệ file nhạy cảm
# Chặn truy cập trực tiếp vào migration files và config

# Chặn migration files
<FilesMatch "^(add_|migrate_).*\.php$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order deny,allow
        Deny from all
    </IfModule>
</FilesMatch>

# Chặn truy cập thư mục config
<FilesMatch "^\.htaccess$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
</FilesMatch>
